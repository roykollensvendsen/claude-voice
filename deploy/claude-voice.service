[Unit]
Description=claude-voice: MCP bridge for driving Claude Code by voice
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/claude-voice
ExecStart=%h/claude-voice/.venv/bin/claude-voice serve --transport http
EnvironmentFile=%h/.config/claude-voice/env
Restart=on-failure
RestartSec=5
# The bridge gives open requests 5 seconds, then closes them; after this, systemd
# kills whatever is left in the service, plugin children included.
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=default.target
