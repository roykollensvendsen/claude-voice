  "protected branches": {
    "branches": ["main", "master"],
    "forced pushes": [
      "git push*--force-with-lease* {branch}",
      "git push*--force-with-lease* {branch} *",
      "git push*--force-with-lease*:{branch}",
      "git push*--force-with-lease*:{branch} *",
      "git push*--force-with-lease*+{branch}",
      "git push*--force-with-lease*+{branch} *",
      "git push*--force-with-lease*/heads/{branch}",
      "git push*--force-with-lease*/heads/{branch} *",
      "git push*--force-with-lease={branch}*",
      "git push*--force-with-lease=refs/heads/{branch}*"
    ],
    "other pushes": [
      "git push* {branch}",
      "git push* {branch} *",
      "git push* *:{branch}",
      "git push* *:{branch} *",
      "git push* */heads/{branch}",
      "git push* */heads/{branch} *",
      "git push* +{branch}",
      "git push* +{branch} *"
